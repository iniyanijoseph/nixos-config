{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "control-center-exclusive-zone": false,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 10,
  "notification-body-image-height": 128,
  "notification-body-image-width": 220,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "notification-grouping": true,
  "control-center-width": 480,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "text-empty": "No notifications",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid#quick",
    "volume",
    "mpris",
    "dnd",
    "inhibitors",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " Clear All "
    },
    "buttons-grid#quick": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "  Wi-Fi",
          "type": "toggle",
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then nmcli radio wifi on; else nmcli radio wifi off; fi'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then bluetoothctl power on; else bluetoothctl power off; fi'",
          "update-command": "sh -c 'bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰖁  Mute",
          "type": "toggle",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰍹  Audio",
          "command": "pavucontrol"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "expand-button-label": " 󰐕 ",
      "collapse-button-label": " 󰐖 ",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "No active audio streams"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false
    },
    "dnd": {
      "text": " Do Not Disturb"
    },
    "inhibitors": {
      "text": "Notification Inhibitors",
      "clear-all-button": true,
      "button-text": "Clear"
    }
  }
}
